<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#203A34" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="8dp" /><stroke android:width="3dp" android:color="@color/on_surface" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#29463D" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="#6D8A7E" /></shape>
    </item>
</selector>
